          "name": "execute_python",
          "args": {
            "code": "import sqlite3\nimport csv\n\n# Connect to the SQLite database\nconn = sqlite3.connect('db/posts.db')\ncursor = conn.cursor()\n\n# Get all post IDs with ViewCount between 100 and 150\ncursor.execute(\"SELECT Id FROM posts WHERE ViewCount >= 100 AND ViewCount <= 150\")\nvalid_post_ids = set(row[0] for row in cursor.fetchall())\nconn.close()\n\nprint(f\"Number of valid posts: {len(valid_post_ids)}\")\n\n# Read comments from CSV and find the one with highest score among valid posts\nmax_score = -float('inf')\nbest_comment = None\n\nwith open('csv/comments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        post_id = int(row['PostId'])\n        if post_id in valid_post_ids:\n            score = int(row['Score'])\n            if score > max_score:\n                max_score = score\n                best_comment = row\n\nprint(f\"Best comment: {best_comment}\")\nprint(f\"Max score: {max_score}\")\n"
          }
        }
      ],
