            "code": "import csv\nfrom collections import defaultdict\n\n# Read attendance data\nevent_member_counts = defaultdict(int)\nwith open('csv/attendance.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # skip header\n    for row in reader:\n        event_id = row[0]\n        event_member_counts[event_id] += 1\n\n# Get events with more than 10 members\nevents_over_10 = {eid: count for eid, count in event_member_counts.items() if count > 10}\nprint(f\"Events with more than 10 members: {len(events_over_10)}\")\nfor eid, count in sorted(events_over_10.items(), key=lambda x: -x[1]):\n    print(f\"  {eid}: {count} members\")\n"
