            "code": "import csv\nimport sqlite3\n\n# Read attendance.csv and count members per event\nevent_counts = {}\nwith open('csv/attendance.csv', 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # skip header\n    for row in reader:\n        event_id = row[0]\n        event_counts[event_id] = event_counts.get(event_id, 0) + 1\n\n# Filter events with more than 10 members\nevents_with_more_than_10 = {eid: count for eid, count in event_counts.items() if count > 10}\nprint(f\"Events with more than 10 members: {len(events_with_more_than_10)}\")\nprint(f\"Event IDs: {list(events_with_more_than_10.keys())}\")\n\n# Connect to event.db and check types of these events\nconn = sqlite3.connect('db/event.db')\ncursor = conn.cursor()\n\nmeeting_count = 0\nfor event_id in events_with_more_than_10:\n    cursor.execute(\"SELECT type FROM event WHERE event_id = ?\", (event_id,))\n    result = cursor.fetchone()\n    if result:\n        event_type = result[0]\n        print(f\"Event {event_id}: type = {event_type}, count = {events_with_more_than_10[event_id]}\")\n        if event_type == \"Meeting\":\n            meeting_count += 1\n\nconn.close()\nprint(f\"\\nNumber of meetings among events with more than 10 members: {meeting_count}\")\n"
          }
        }
